@model IEnumerable<ExamMvc.Models.Album>

@{
    ViewBag.Title = "Music Albums";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    string selectedCategory = ViewBag.Category as string;
}

<h2>Music Albums</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@using (Html.BeginForm("Index", "Albums", FormMethod.Get, new { @class = "form-inline", style = "margin-bottom:15px" }))
{
    <label for="search">Search</label>
    <input id="search" name="search" type="text" value="@(ViewBag.Search ?? "")" class="form-control" />
    <label for="category">Genre</label>
    <select id="category" name="category" class="form-control">
        <option value="">All genres</option>
        @foreach (string category in categories)
        {
            <option value="@category" @(category == selectedCategory ? "selected" : "")>@category</option>
        }
    </select>
    <button type="submit" class="btn btn-default">Search</button>
}

<p style="margin-top:15px">
    @Html.ActionLink("Add album", "Create", null, new { @class = "btn btn-primary" })
</p>

<p>Albums found: <b>@Model.Count()</b></p>

<table class="table">
    <tr>
        <th>@Html.DisplayNameFor(model => model.Title)</th>
        <th>@Html.DisplayNameFor(model => model.Artist)</th>
        <th>@Html.DisplayNameFor(model => model.Genre)</th>
        <th>@Html.DisplayNameFor(model => model.Year)</th>
        <th>@Html.DisplayNameFor(model => model.Price)</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Title)</td>
            <td>@Html.DisplayFor(modelItem => item.Artist)</td>
            <td>@Html.DisplayFor(modelItem => item.Genre)</td>
            <td>@Html.DisplayFor(modelItem => item.Year)</td>
            <td>@Html.DisplayFor(modelItem => item.Price)</td>
            <td>
                @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.Id })
            </td>
        </tr>
    }
</table>
